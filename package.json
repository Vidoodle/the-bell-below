{
  "name": "the-bell-below",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:server && concurrently --kill-others --names types,api,web \"tsc -p tsconfig.server.json --watch --preserveWatchOutput\" \"node --watch .server-dist/server.js\" \"vite\"",
    "build": "tsc && pnpm run build:server && vite build",
    "build:server": "rimraf .server-dist && tsc -p tsconfig.server.json",
    "start": "node .server-dist/server.js --production",
    "test": "pnpm run build:server && node --test .server-dist/server/**/*.test.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "^10.0.5",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
